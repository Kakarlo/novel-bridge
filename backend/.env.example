# NovelBridge backend configuration
# Copy to .env and adjust for your environment.

# Translation engine: "ollama" (default), "mock", "openrouter", or "gemini"
NB_ENGINE=ollama

# Debug: print assembled chat prompts to stdout (translation + glossary pairing). Handy while
# tuning prompts; keep OFF for any shared/hosted run so logs stay clean and content isn't dumped.
NB_DEBUG_PROMPTS=false

# Ollama server (home-server address verified during design)
OLLAMA_BASE_URL=http://192.168.254.22:11434
OLLAMA_MODEL=qwen3.5:0.8b
# Context window passed in request options (model supports up to 262144)
OLLAMA_NUM_CTX=16384
# CPU threads per request (lower = leaves headroom for other sessions)
OLLAMA_NUM_THREAD=2
# Allow the model's "thinking" preamble? false => prose-only output
OLLAMA_THINK=false

# Total token budget for the assembled context (headroom under NUM_CTX for the reply)
NB_CONTEXT_BUDGET_TOKENS=12000

# Max simultaneous in-flight translations (default 1). Caps PARALLEL requests;
# OLLAMA_NUM_THREAD caps CPU within a single request.
NB_MAX_CONCURRENT_TRANSLATIONS=1
# How long a queued request waits (seconds) for a free slot before giving up with an
# SSE error, so clients don't block indefinitely.
NB_QUEUE_TIMEOUT_SECONDS=30

# SQLite database file path
NB_DB_PATH=./novelbridge.db

# Comma-separated allowed frontend origins (CORS)
NB_CORS_ORIGINS=http://localhost:5173

# --- Cloud engines (bring-your-own API key) -----------------------------------
# Hosted providers behind the same TranslationEngine interface. Set NB_ENGINE to the
# provider name, then fill in the API key. The default model is overridable per-request
# via the translate `selection` body field.
# NEVER check your real API keys into version control — .env is gitignored.

# OpenRouter (gateway to 200+ models: DeepSeek, Claude, GPT, Gemini, Mistral, etc.)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (harmless if blank; not secrets).
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=NovelBridge

# Google Gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Shared cloud request timeout (seconds).
CLOUD_TIMEOUT_SECONDS=300

# --- EXPERIMENTAL deterministic helpers (default off; cheap to remove) ---
# zh/ja source-language proper-noun detection via spaCy. Needs a model installed:
#   python -m spacy download zh_core_web_sm   (Chinese, ~48MB)
#   python -m spacy download ja_core_news_sm  (Japanese, ~40MB)
# Returns [] if the model is missing. Endpoint: GET /api/references/{id}/source-terms
NB_SOURCE_TERMS=false
# English pronoun-drift DETECTION (flags likely gender/pronoun mismatches for gendered
# characters; never rewrites the translation). stdlib-only, no model needed.
# Endpoint: GET /api/translations/{tid}/pronoun-drift
NB_PRONOUN_CHECK=false
