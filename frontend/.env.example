# Frontend build-time config (Vite). Copy to `.env.local` for local overrides.

# Which StorageService the app uses by default:
#   idb  — browser-local IndexedDB store; no user data touches the server (hosted default).
#   api  — the FastAPI + SQLite backend; for self-hosting / local development.
# Unset defaults to `api`. The production build (.env.production) sets this to `idb`.
# A per-browser dev override is also available at runtime:
#   localStorage.setItem("nb:storage", "idb" | "api")  then reload.
VITE_STORAGE_BACKEND=api
