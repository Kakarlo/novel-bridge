# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.db    binary
*.sqlite binary
*.sqlite3 binary
